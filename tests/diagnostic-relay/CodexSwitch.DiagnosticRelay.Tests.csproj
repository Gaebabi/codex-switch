<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/diagnostics/RelayInstallation.cs" Link="RelayInstallation.cs" />
    <Compile Include="../../src/diagnostics/DiagnosticRelay.cs" Link="DiagnosticRelay.cs" />
    <Compile Include="../../src/diagnostics/NativeRelayProcess.cs" Link="NativeRelayProcess.cs" />
    <Compile Include="../../src/diagnostics/NetworkTelemetry.cs" Link="NetworkTelemetry.cs" />
    <Compile Include="../../src/diagnostics/ProtocolTelemetry.cs" Link="ProtocolTelemetry.cs" />
    <Compile Include="../../src/diagnostics/ResourceTelemetry.cs" Link="ResourceTelemetry.cs" />
    <Compile Include="../../src/application/DiagnosticGatewayEndpoint.cs" Link="DiagnosticGatewayEndpoint.cs" />
  </ItemGroup>
  <Target Name="RunRelayContracts" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
