root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,csproj,props,svg,plist}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{png,ico,icns,gif}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
