<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexSwitch.Core</AssemblyName>
    <RootNamespace>CodexAccountDesk</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodexSwitch.LinuxHandoff.Tests" />
    <InternalsVisibleTo Include="CodexSwitch" />
    <InternalsVisibleTo Include="CodexSwitch.Demo" />
    <InternalsVisibleTo Include="CodexSwitch.Localization.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.Temperatures.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.WindowsHandoff.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.Protocol" />
    <InternalsVisibleTo Include="CodexSwitch.Application" /><InternalsVisibleTo Include="CodexSwitch.Desktop" /><InternalsVisibleTo Include="CodexSwitch.Composition.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.LinuxVault.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.Hardware" /><InternalsVisibleTo Include="CodexSwitch.Hardware.Tests" />
    <EmbeddedResource Include="../../localization/packs/*.json;../../localization/index.json;../../localization/legacy-keys.json" WithCulture="false" LogicalName="CodexAccountDesk.LanguagePacks.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
