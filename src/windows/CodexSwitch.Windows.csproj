<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>CodexAccountDesk.Program</StartupObject>
    <AssemblyName>CodexSwitch</AssemblyName>
    <RootNamespace>CodexAccountDesk</RootNamespace>
    <Title>Codex Switch</Title>
    <Product>Codex Switch</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/brand/app-icon.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodexSwitch.ModelProviders.Tests" />
    <AssemblyMetadata Include="CodexSwitch.CpuSensorSha256" Value="$(CpuSensorWorkerSha256)" Condition="'$(CpuSensorWorkerSha256)' != ''" />
    <ProjectReference Include="../core/CodexSwitch.Core.csproj" />
    <ProjectReference Include="../platforms/security/CodexSwitch.PlatformSecurity.csproj" />
    <ProjectReference Include="../platforms/client/CodexSwitch.DesktopClient.csproj" />
    <ProjectReference Include="../platforms/protocol/CodexSwitch.Protocol.csproj" />
    <ProjectReference Include="../platforms/resources/CodexSwitch.Hardware.csproj" />
    <ProjectReference Include="../application/CodexSwitch.Application.csproj" />
    <EmbeddedResource Include="../../assets/brand/mark.path" LogicalName="CodexAccountDesk.Mark.path" />
    <EmbeddedResource Include="../../assets/brand/mark-body.path" LogicalName="CodexAccountDesk.MarkBody.path" />
    <EmbeddedResource Include="../../assets/brand/app-icon.ico" LogicalName="CodexAccountDesk.AppIcon.ico" />
    <EmbeddedResource Include="../../resources/Burn0Tokens.css" LogicalName="CodexAccountDesk.Burn0Tokens.css" />
    <EmbeddedResource Include="../../resources/Burn0Icons.json" LogicalName="CodexAccountDesk.Burn0Icons.json" />
  </ItemGroup>
</Project>
