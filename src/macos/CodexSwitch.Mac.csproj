<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexSwitch</AssemblyName>
    <RootNamespace>CodexAccountDesk</RootNamespace>
    <Title>Codex Switch</Title>
    <Product>Codex Switch</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <DebugType>none</DebugType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/CodexSwitch.Core.csproj" />
    <ProjectReference Include="../platforms/security/CodexSwitch.PlatformSecurity.csproj" />
    <ProjectReference Include="../platforms/client/CodexSwitch.DesktopClient.csproj" />
    <ProjectReference Include="../platforms/protocol/CodexSwitch.Protocol.csproj" />
    <ProjectReference Include="../platforms/resources/CodexSwitch.Hardware.csproj" />
    <ProjectReference Include="../application/CodexSwitch.Application.csproj" />
    <ProjectReference Include="../desktop/CodexSwitch.Desktop.csproj" />
  </ItemGroup>
</Project>
