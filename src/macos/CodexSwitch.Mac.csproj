<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexSwitch</AssemblyName>
    <RootNamespace>CodexAccountDesk</RootNamespace>
    <Title>Codex Switch</Title>
    <Product>Codex Switch</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <DebugType>none</DebugType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/CodexSwitch.Core.csproj" />
    <ProjectReference Include="../platforms/security/CodexSwitch.PlatformSecurity.csproj" />
    <ProjectReference Include="../platforms/client/CodexSwitch.DesktopClient.csproj" />
    <ProjectReference Include="../platforms/protocol/CodexSwitch.Protocol.csproj" />
    <ProjectReference Include="../platforms/resources/CodexSwitch.Hardware.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <Compile Include="../shared/**/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../resources/Burn0Tokens.css" LogicalName="CodexAccountDesk.Burn0Tokens.css" />
    <EmbeddedResource Include="../../resources/Burn0Icons.json" LogicalName="CodexAccountDesk.Burn0Icons.json" />
    <AvaloniaResource Include="../../assets/macos/**" Link="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/brand/mark.path" LogicalName="CodexAccountDesk.Mark.path" />
  </ItemGroup>
</Project>
