    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CodexSwitch.Sensors</AssemblyName><RootNamespace>CodexSwitch.Sensors</RootNamespace>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><DebugType>none</DebugType>
    <PublishAot>true</PublishAot><InvariantGlobalization>true</InvariantGlobalization>
