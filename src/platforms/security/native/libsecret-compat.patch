+static gboolean
+codex_derive_session_key (SecretSession *session, GBytes *ikm)
+{
+	session->n_key = 16;
+	session->key = egg_secure_alloc (session->n_key);
+	{
+		gsize length;
+		const guchar *bytes = g_bytes_get_data (ikm, &length);
+		while (session->codex_kwallet && length > 1 && bytes[0] == 0) {
+			bytes++;
+			length--;
+		}
+		if (!egg_hkdf_perform ("sha256", bytes, length, NULL, 0, NULL, 0,
+		                       session->key, session->n_key)) {
+			return FALSE;
+		}
+	}
+	return TRUE;
+}
 
