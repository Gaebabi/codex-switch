--- /dev/null
+++ b/libsecret/secret-codex.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "config.h"
+#include "secret-private.h"
+#include "egg/egg-fips.h"
+
+#ifndef WITH_GCRYPT
+#error The private compatibility library requires the libgcrypt encrypted backend.
+#endif
+
+guint secret_codex_compat_abi (void) { return 1; }
+
+SecretService *
+secret_codex_service_open_sync (const gchar *owner,
+                                gboolean kwallet,
+                                GCancellable *cancellable,
+                                GError **error)
+{
+    SecretService *service;
+    if (!g_dbus_is_unique_name (owner) || (kwallet != FALSE && kwallet != TRUE)) {
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "A verified unique provider owner is required");
+        return NULL;
+    }
+    if (egg_fips_get_mode () != EGG_FIPS_MODE_DISABLED) {
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "The Secret Service DH group is unavailable under enforced FIPS policy");
+        return NULL;
+    }
+    service = secret_service_open_sync (SECRET_TYPE_SERVICE, owner, SECRET_SERVICE_NONE, cancellable, error);
+    if (service == NULL) return NULL;
+    g_object_set_data (G_OBJECT (service), "codex-kwallet-encoding", GINT_TO_POINTER (kwallet));
+    if (!secret_service_ensure_session_sync (service, cancellable, error)) {
+        g_object_unref (service);
+        return NULL;
+    }
+    return service;
+}
