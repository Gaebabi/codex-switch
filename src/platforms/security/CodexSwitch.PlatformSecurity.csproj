<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexSwitch.PlatformSecurity</AssemblyName>
    <RootNamespace>CodexAccountDesk</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <CodexSecretDir Condition="'$(CodexSecretDir)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/linux-secret</CodexSecretDir>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodexSwitch" />
    <InternalsVisibleTo Include="CodexSwitch.Demo" />
    <InternalsVisibleTo Include="CodexSwitch.Localization.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.Temperatures.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.WindowsHandoff.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.PlatformSecurity.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.DesktopClient" />
    <InternalsVisibleTo Include="CodexSwitch.Hardware" />
    <InternalsVisibleTo Include="CodexSwitch.Application" />
    <InternalsVisibleTo Include="CodexSwitch.LinuxVault.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.LinuxClient.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.LinuxDesktop.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.DesktopClient.Tests" />
    <InternalsVisibleTo Include="CodexSwitch.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LinuxSecretProviders.json" LogicalName="CodexAccountDesk.LinuxSecretProviders.json" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('$(CodexSecretDir)/libcodex-switch-secret-1.so.0')">
    <None Include="$(CodexSecretDir)/libcodex-switch-secret-1.so.0" Link="libcodex-switch-secret-1.so.0" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../../licenses/libsecret.LGPL-2.1.txt" Link="licenses/libsecret.LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
